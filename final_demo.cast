[13.117190837860107,"o","Доступные команды:\r\n  help — показать справку\r\n  exit — завершить программу\r\n  create_table <name> <column:type> ... — создать таблицу\r\n  drop_table <name> — удалить таблицу\r\n  list_tables — показать таблицы\r\n  info <name> — информация о таблице\r\n  insert into <name> values (\"Anna\", 23) — добавить запись\r\n  select from <name> [where age = 23] — найти записи\r\n  update <name> set age = 24 where ID = 1 — изменить записи\r"]
[13.117303133010864,"o","\n  delete from <name> where ID = 1 — удалить записи\r"]
